{
	"name": "p5-garden",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_flags": ["nodejs_als"],
	"compatibility_date": "2026-10-13",
	"routes": [{ "pattern": "garden.edwinzhao.com", "custom_domain": true }],
	"workers_dev": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
